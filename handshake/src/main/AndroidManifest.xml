<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- What the setup wizard holds to start ManagedProvisioning. Granted only
         because the APK is signed with the emulator image's platform key. -->
    <uses-permission android:name="android.permission.DISPATCH_PROVISIONING_MESSAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Handshake"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".TriggerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".DeploymentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
