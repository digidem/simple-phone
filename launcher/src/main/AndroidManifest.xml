<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          singleInstance keeps the launcher out of any other task.
          lockTaskMode="if_whitelisted" is what makes lock task re-enter by
          itself whenever the activity starts, which is how the lock survives a
          reboot without any code running at boot to restore it.
        -->
        <activity
            android:name="app.comapeo.kiosk.launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:lockTaskMode="if_whitelisted"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
